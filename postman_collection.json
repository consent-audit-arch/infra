		{
			"name": "User Service",
			"description": "Serviço de usuários (porta {{user_service_port}}). Endpoints abertos não precisam de token; endpoints protegidos usam token_password.",
			"item": [
				{
					"name": "Create User",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status 201 Created', () => pm.expect(pm.response.code).to.equal(201));",
									"",
									"const json = pm.response.json();",
									"if (json && json.id) {",
									"    pm.collectionVariables.set('user_id', String(json.id));",
									"    pm.test('User ID salvo', () => pm.expect(json.id).to.not.be.empty);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"fullName\": \"João Silva\",\n    \"email\": \"joao@example.com\",\n    \"documentNumber\": \"12345678900\",\n    \"birthDate\": \"1990-01-01\"\n}"
						},
						"url": {
							"raw": "{{base_url}}:{{user_service_port}}/api/v1/users",
							"host": ["{{base_url}}"],
							"port": "{{user_service_port}}",
							"path": ["api", "v1", "users"]
						}
					}
				},
				{
					"name": "List All Users",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}:{{user_service_port}}/api/v1/users",
							"host": ["{{base_url}}"],
							"port": "{{user_service_port}}",
							"path": ["api", "v1", "users"]
						}
					}
				},
				{
					"name": "Get User by ID (protegido)",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{token_client_credentials}}" },
							{ "key": "X-Purpose", "value": "BILLING" },
							{ "key": "X-Data-Subject-Id", "value": "{{user_id}}" },
							{ "key": "X-Data-Categories", "value": "PERSONAL_DATA" },
							{ "key": "X-Correlation-Id", "value": "{{$guid}}" }
						],
						"url": {
							"raw": "{{base_url}}:{{user_service_port}}/api/v1/users/{{user_id}}",
							"host": ["{{base_url}}"],
							"port": "{{user_service_port}}",
							"path": ["api", "v1", "users", "{{user_id}}"]
						}
					}
				},
				{
					"name": "Batch Users (protegido)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{token_client_credentials}}" },
							{ "key": "X-Purpose", "value": "BILLING" },
							{ "key": "X-Correlation-Id", "value": "{{$guid}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"ids\": [1, 2]\n}"
						},
						"url": {
							"raw": "{{base_url}}:{{user_service_port}}/api/v1/users/batch",
							"host": ["{{base_url}}"],
							"port": "{{user_service_port}}",
							"path": ["api", "v1", "users", "batch"]
						}
					}
				}
			]
		},
