{
	"info": {
		"name": "TCC Consentimento LGPD",
		"description": "Collection completa para testes do sistema de consentimento LGPD.\n\n## Pré-requisito\nRodar o script de setup do Keycloak:\n```\ncd infra && ./setup-keycloak.sh\n```\n\n## Fluxo recomendado\n1. Auth → Get Token (billing-service)\n2. User Service → Create User\n3. Consent Command → Grant Consent\n4. Explore os demais endpoints\n\n## Enums válidos\n\n### DataCategory\n`PERSONAL_DATA`, `CONTRACT_DATA`, `FINANCIAL_DATA`\n\n### Purpose\n`PROMOTION`, `BILLING`, `ANALYTICS`, `CUSTOMER_SERVICE`\n\n### IssuerType\n`USER`, `OPERATOR`, `SYSTEM`\n\n## Serviços\n| Serviço | Porta |\n|---|---|\n| consent-command | 8080 |\n| consent-query | 8081 |\n| dashboard | 8082 |\n| user-service | 8083 |\n| billing-service | 8084 |\n| audit-service | 8086 |\n| Keycloak | 8180 |",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{ "key": "base_url", "value": "http://localhost", "type": "string" },
		{ "key": "kc_url", "value": "http://localhost:8180", "type": "string" },
		{ "key": "consent_command_port", "value": "8080", "type": "string" },
		{ "key": "consent_query_port", "value": "8081", "type": "string" },
		{ "key": "dashboard_port", "value": "8082", "type": "string" },
		{ "key": "user_service_port", "value": "8083", "type": "string" },
		{ "key": "billing_service_port", "value": "8084", "type": "string" },
		{ "key": "audit_service_port", "value": "8086", "type": "string" },
		{ "key": "billing_client_secret", "value": "billing_demo", "type": "string" },
		{ "key": "postman_client_secret", "value": "postman_demo", "type": "string" },
		{ "key": "test_username", "value": "testuser", "type": "string" },
		{ "key": "test_password", "value": "testpass", "type": "string" },
		{ "key": "token_client_credentials", "value": "", "type": "string" },
		{ "key": "token_password", "value": "", "type": "string" },
		{ "key": "user_id", "value": "", "type": "string" },
		{ "key": "billing_id", "value": "", "type": "string" },
		{ "key": "correlation_id", "value": "", "type": "string" }
	],
	"item": [
		{
			"name": "Auth",
			"description": "Endpoints para obter tokens de acesso via Keycloak.",
			"item": [
				{
					"name": "Get Token (billing-service / client_credentials)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const json = pm.response.json();",
									"pm.collectionVariables.set('token_client_credentials', json.access_token);",
									"",
									"pm.test('Token obtido com sucesso', () => {",
									"    pm.expect(json.access_token).to.not.be.empty;",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" },
							{ "key": "Authorization", "value": "Basic {{billing_client_secret}}", "disabled": true }
						],
						"body": {
							"mode": "urlencoded",
							"urlencoded": [
								{ "key": "grant_type", "value": "client_credentials", "type": "text" },
								{ "key": "client_id", "value": "billing-service", "type": "text" },
								{ "key": "client_secret", "value": "{{billing_client_secret}}", "type": "text" }
							]
						},
						"url": {
							"raw": "{{kc_url}}/realms/tcc/protocol/openid-connect/token",
							"host": ["{{kc_url}}"],
							"path": ["realms", "tcc", "protocol", "openid-connect", "token"]
						}
					}
				},
				{
					"name": "Get Token (postman / password grant)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const json = pm.response.json();",
									"pm.collectionVariables.set('token_password', json.access_token);",
									"",
									"pm.test('Token obtido com sucesso', () => {",
									"    pm.expect(json.access_token).to.not.be.empty;",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
						],
						"body": {
							"mode": "urlencoded",
							"urlencoded": [
								{ "key": "grant_type", "value": "password", "type": "text" },
								{ "key": "client_id", "value": "postman", "type": "text" },
								{ "key": "client_secret", "value": "{{postman_client_secret}}", "type": "text" },
								{ "key": "username", "value": "{{test_username}}", "type": "text" },
								{ "key": "password", "value": "{{test_password}}", "type": "text" }
							]
						},
						"url": {
							"raw": "{{kc_url}}/realms/tcc/protocol/openid-connect/token",
							"host": ["{{kc_url}}"],
							"path": ["realms", "tcc", "protocol", "openid-connect", "token"]
						}
					}
				}
			]
		},
		{
			"name": "Consent Command",
			"description": "Serviço de comandos de consentimento (porta {{consent_command_port}}). Usa token client_credentials.",
			"item": [
				{
					"name": "Grant Consent",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status 202 Accepted', () => pm.expect(pm.response.code).to.equal(202));"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{token_client_credentials}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"ownerId\": 1,\n    \"legalBasis\": \"CONSENT\",\n    \"occurredAt\": \"2025-05-25T05:00:00\",\n    \"issuedBy\": {\n        \"id\": 1,\n        \"issuer\": \"USER\"\n    },\n    \"authorizations\": [\n        {\n            \"dataCategory\": \"FINANCIAL_DATA\",\n            \"purposes\": [\"BILLING\"]\n        },\n        {\n            \"dataCategory\": \"PERSONAL_DATA\",\n            \"purposes\": [\"BILLING\"]\n        }\n    ]\n}"
						},
						"url": {
							"raw": "{{base_url}}:{{consent_command_port}}/api/v1/consent",
							"host": ["{{base_url}}"],
							"port": "{{consent_command_port}}",
							"path": ["api", "v1", "consent"]
						}
					}
				},
				{
					"name": "Revoke Consent",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status 202 Accepted', () => pm.expect(pm.response.code).to.equal(202));"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{token_client_credentials}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"ownerId\": 1,\n    \"authorizations\": [\n        {\n            \"dataCategory\": \"PERSONAL_DATA\",\n            \"purposes\": [\"BILLING\"]\n        }\n    ],\n    \"reason\": \"User requested data removal\",\n    \"occurredAt\": \"2025-05-25T05:00:00\",\n    \"issuedBy\": {\n        \"id\": 1,\n        \"issuer\": \"SYSTEM\"\n    }\n}"
						},
						"url": {
							"raw": "{{base_url}}:{{consent_command_port}}/api/v1/consent/1/revoke",
							"host": ["{{base_url}}"],
							"port": "{{consent_command_port}}",
							"path": ["api", "v1", "consent", "1", "revoke"]
						}
					}
				}
			]
		},
		{
			"name": "Consent Query",
			"description": "Serviço de consulta de consentimentos (porta {{consent_query_port}}). Usa token client_credentials.",
			"item": [
				{
					"name": "Get Consents by User",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status 200', () => pm.expect(pm.response.code).to.equal(200));",
									"",
									"const json = pm.response.json();",
									"if (json && json.length > 0) {",
									"    pm.test('Consentimentos retornados', () => pm.expect(json.length).to.be.above(0));",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{token_client_credentials}}" }
						],
						"url": {
							"raw": "{{base_url}}:{{consent_query_port}}/api/v1/consent/{{user_id}}",
							"host": ["{{base_url}}"],
							"port": "{{consent_query_port}}",
							"path": ["api", "v1", "consent", "{{user_id}}"]
						}
					}
				},
				{
					"name": "Check Authorization",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{token_client_credentials}}" }
						],
						"url": {
							"raw": "{{base_url}}:{{consent_query_port}}/api/v1/consent/{{user_id}}/authorizations?dataCategory=PERSONAL_DATA&purpose=BILLING",
							"host": ["{{base_url}}"],
							"port": "{{consent_query_port}}",
							"path": ["api", "v1", "consent", "{{user_id}}", "authorizations"],
							"query": [
								{ "key": "dataCategory", "value": "PERSONAL_DATA" },
								{ "key": "purpose", "value": "BILLING" }
							]
						}
					}
				},
				{
					"name": "Get Consent History",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{token_client_credentials}}" }
						],
						"url": {
							"raw": "{{base_url}}:{{consent_query_port}}/api/v1/consent/{{user_id}}/history",
							"host": ["{{base_url}}"],
							"port": "{{consent_query_port}}",
							"path": ["api", "v1", "consent", "{{user_id}}", "history"]
						}
					}
				},
				{
					"name": "Batch Authorization",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{token_client_credentials}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"userIds\": [1],\n    \"dataCategory\": \"PERSONAL_DATA\",\n    \"purpose\": \"BILLING\"\n}"
						},
						"url": {
							"raw": "{{base_url}}:{{consent_query_port}}/api/v1/consent/batch/authorizations",
							"host": ["{{base_url}}"],
							"port": "{{consent_query_port}}",
							"path": ["api", "v1", "consent", "batch", "authorizations"]
						}
					}
				}
			]
		},
